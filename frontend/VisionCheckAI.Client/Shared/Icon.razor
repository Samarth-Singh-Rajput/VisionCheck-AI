@* Self-hosted inline SVG icons. Stroke-based, 24-grid, sized by caller. *@

<svg xmlns="http://www.w3.org/2000/svg"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="@Class"
     aria-hidden="true"
     focusable="false">
    @switch (Name)
    {
        case "mark":
            <path d="M12 2.6 20.1 7v10L12 21.4 3.9 17V7z" />
            <circle cx="12" cy="12" r="3.4" />
            <path d="M3.9 12h1.9" />
            <path d="M18.2 12h1.9" />
            break;

        case "dashboard":
            <rect x="3" y="3" width="7" height="9" rx="1" />
            <rect x="14" y="3" width="7" height="5" rx="1" />
            <rect x="14" y="12" width="7" height="9" rx="1" />
            <rect x="3" y="16" width="7" height="5" rx="1" />
            break;

        case "scan":
            <path d="M3 7V5a2 2 0 0 1 2-2h2" />
            <path d="M17 3h2a2 2 0 0 1 2 2v2" />
            <path d="M21 17v2a2 2 0 0 1-2 2h-2" />
            <path d="M7 21H5a2 2 0 0 1-2-2v-2" />
            <path d="M7 12h10" />
            break;

        case "history":
            <path d="M3 3v5h5" />
            <path d="M3.05 13A9 9 0 1 0 6 5.3L3 8" />
            <path d="M12 7v5l4 2" />
            break;

        case "logout":
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <path d="m16 17 5-5-5-5" />
            <path d="M21 12H9" />
            break;

        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" />
            <path d="M12 20v2" />
            <path d="m4.9 4.9 1.4 1.4" />
            <path d="m17.7 17.7 1.4 1.4" />
            <path d="M2 12h2" />
            <path d="M20 12h2" />
            <path d="m6.3 17.7-1.4 1.4" />
            <path d="m19.1 4.9-1.4 1.4" />
            break;

        case "moon":
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            break;

        case "upload":
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <path d="m17 8-5-5-5 5" />
            <path d="M12 3v12" />
            break;

        case "image":
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <circle cx="8.5" cy="8.5" r="1.5" />
            <path d="m21 15-5-5L5 21" />
            break;

        case "check":
            <path d="M20 6 9 17l-5-5" />
            break;

        case "check-circle":
            <path d="M22 11.1V12a10 10 0 1 1-5.9-9.1" />
            <path d="M22 4 12 14l-3-3" />
            break;

        case "alert-triangle":
            <path d="M10.3 3.9 2.1 17.9A2 2 0 0 0 3.8 21h16.4a2 2 0 0 0 1.7-3.1l-8.2-14a2 2 0 0 0-3.4 0z" />
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
            break;

        case "info":
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
            break;

        case "x":
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
            break;

        case "chevron-left":
            <path d="m15 18-6-6 6-6" />
            break;

        case "chevron-right":
            <path d="m9 18 6-6-6-6" />
            break;

        case "filter":
            <path d="M22 3H2l8 9.5V19l4 2v-8.5z" />
            break;

        case "refresh":
            <path d="M21 12a9 9 0 1 1-2.6-6.4" />
            <path d="M21 3v6h-6" />
            break;

        case "loader":
            <path d="M12 3v3" />
            <path d="M12 18v3" />
            <path d="M5.6 5.6 7.8 7.8" />
            <path d="m16.2 16.2 2.2 2.2" />
            <path d="M3 12h3" />
            <path d="M18 12h3" />
            <path d="m5.6 18.4 2.2-2.2" />
            <path d="m16.2 7.8 2.2-2.2" />
            break;

        case "shield":
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="m9 12 2 2 4-4" />
            break;

        case "user":
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" />
            break;

        case "box":
            <path d="M21 8 12 3 3 8v8l9 5 9-5z" />
            <path d="m3 8 9 5 9-5" />
            <path d="M12 13v8" />
            break;

        case "activity":
            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            break;

        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    /// <summary>Icon key, e.g. "dashboard", "scan", "history".</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int Size { get; set; } = 16;

    [Parameter]
    public double StrokeWidth { get; set; } = 1.5;

    [Parameter]
    public string? Class { get; set; }
}
